# Copy to .env (cp .env.example .env). Every variable the local stack reads is listed here.
# .env is git-ignored. Values below are LOCAL-ONLY defaults — never reuse them anywhere real.

# ----------------------------------------------------------------------------- what `docker compose up` starts
# core (postgres, redis, migrations, app) always runs. Add profiles:
#   obs   = OpenTelemetry Collector, Tempo, Loki, Prometheus, Alertmanager, Grafana, exporters
#   tools = Mailpit (fake SMTP inbox), Adminer (database browser)
COMPOSE_PROFILES=obs,tools

# ----------------------------------------------------------------------------- application
ENV=local
APP_VERSION=dev
APP_PORT=8000
# Empty = every installed service. Or e.g. ENABLED_SERVICES=auth,users
ENABLED_SERVICES=
# Set true to run without exporting telemetry (logs still print).
OTEL_SDK_DISABLED=false

# ----------------------------------------------------------------------------- database / cache
POSTGRES_PASSWORD=postgres
POSTGRES_DB=befastapi

# ----------------------------------------------------------------------------- host ports (change on conflict)
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
TEMPO_PORT=3200
LOKI_PORT=3100
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
MAILPIT_UI_PORT=8025
ADMINER_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# ----------------------------------------------------------------------------- grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Metric export interval in ms (SDK default is 60000)
OTEL_METRIC_EXPORT_INTERVAL=15000
