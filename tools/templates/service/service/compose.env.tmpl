# Extra environment variables for the monolith container under docker-compose (local stack).
# One KEY=VALUE per line, UPPER_CASE keys; lines starting with # are ignored.
# tools/sync_workspace.py copies them into docker-compose.yml's generated block, so nobody hand-edits compose (rule E-1).
# Values may use compose substitution, e.g.  {{SERVICE}}_SOMETHING=${SOMETHING:-default}
