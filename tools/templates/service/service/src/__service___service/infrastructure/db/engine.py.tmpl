from sqlalchemy.ext.asyncio import AsyncEngine, AsyncSession, async_sessionmaker

from platform_core.db import create_engine, create_session_factory
from {{service}}_service.infrastructure.db.models import SCHEMA
from {{service}}_service.settings import {{Service}}Settings


def build_engine(settings: {{Service}}Settings) -> tuple[AsyncEngine, async_sessionmaker[AsyncSession]]:
    engine = create_engine(
        settings.database_url, pool_size=settings.db_pool_size, max_overflow=settings.db_max_overflow
    )
    if settings.database_url.startswith("sqlite"):
        # SQLite has no schemas: tests map the service schema to the default one.
        engine = engine.execution_options(schema_translate_map={SCHEMA: None})
    return engine, create_session_factory(engine)
