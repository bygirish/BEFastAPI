"""Contract tests (rule T-3): the SAME assertions run against the in-process implementation and the
HTTP client talking to the real /internal routes. This is what makes extraction a wiring change."""

from collections.abc import AsyncIterator

import pytest
from httpx import ASGITransport

from platform_http import ServiceHttpClient, create_application
from platform_security.testing import TestAuth
from {{service}}_contracts import {{Service}}Api, {{Service}}HttpClient
from {{service}}_service.infrastructure.db.models import metadata
from {{service}}_service.module import {{Service}}Module
from {{service}}_service.settings import {{Service}}Settings


@pytest.fixture(params=["in_process", "http"])
async def api(request: pytest.FixtureRequest, tmp_path) -> AsyncIterator[{{Service}}Api]:  # type: ignore[no-untyped-def]
    settings = {{Service}}Settings(database_url=f"sqlite+aiosqlite:///{tmp_path}/{{service}}.db")
    module = {{Service}}Module(settings)
    async with module.engine.begin() as conn:
        await conn.run_sync(metadata.create_all)
    auth = TestAuth()
    app = create_application(
        title="t", service_name="{{service}}-tests", modules=[module], telemetry=False, jwt_verifier=auth.verifier
    )
    async with app.router.lifespan_context(app):
        if request.param == "in_process":
            yield app.state.container.resolve({{Service}}Api)  # the module's own binding: survives constructor changes
        else:
            async def token() -> str:
                return auth.service_token()

            transport = ASGITransport(app=app)
            client = ServiceHttpClient("http://{{service}}", target="{{service}}", token_provider=token, transport=transport)
            yield {{Service}}HttpClient(client)
            await client.aclose()


async def test_ping_contract(api: {{Service}}Api) -> None:
    result = await api.ping()
    assert result.service == "{{service}}"
    assert result.message == "pong"
